# =============================================================================
# .gitignore
# Enforces the privacy boundary. Directories that MUST NEVER be committed
# publicly are listed first and in full.
# =============================================================================

# ---- NEVER COMMIT: sensitive / identifying / raw scanner output ----
data/private/
repositories/
results/raw/
results/reports/private-repositories/

# Redacted and normalized results are also excluded by default; publish only
# curated aggregates from data/public/ and results/reports/public-*.
results/redacted/
results/normalized/
results/deduplicated/
results/validation/

# Generated, machine-specific manifests/checksums (regenerated by `make check` /
# `make freeze`); do not commit host-specific paths to the public repo.
results/reports/*.json
results/reports/*.txt
!results/reports/.gitkeep

# Raw GitHub search dumps and interim datasets can contain repo identities.
data/raw/
data/interim/
data/processed/
# (data/public/ IS allowed to be committed once curated & anonymised.)

# Anonymization keys / any secret material
*.key
*.pem
*.p12
.env
.env.*
!.env.example

# ---- Scanner rule caches / vuln DB snapshots (large, reproducible) ----
config/semgrep-rules-cache/
.trivycache/
.cache/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Logs & temp ----
logs/*.log
*.tmp
.empty-hooks/

# ---- Allow-list: keep these tracked even under ignored trees ----
!data/public/.gitkeep
!logs/.gitkeep
