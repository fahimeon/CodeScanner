# Scanner image: static analysis only. Bundles gitleaks, semgrep, trivy,
# osv-scanner, and zizmor. Contains NO package managers for repository
# languages and NO build toolchains — it cannot install or run repository code.
#
# Versions are pinned via build args so the exact toolchain is reproducible and
# recorded in the environment manifest. Update deliberately, never silently.
FROM python:3.11-slim-bookworm

ARG GITLEAKS_VERSION=8.21.2
ARG TRIVY_VERSION=0.58.0
ARG OSV_SCANNER_VERSION=1.9.2
ARG SEMGREP_VERSION=1.97.0
ARG ZIZMOR_VERSION=1.0.1
ARG TARGETARCH=amd64

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*

# --- gitleaks ---
RUN curl -fsSL -o /tmp/gitleaks.tar.gz \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
    && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && rm /tmp/gitleaks.tar.gz && chmod +x /usr/local/bin/gitleaks

# --- trivy ---
RUN curl -fsSL "https://raw.githubusercontent.com/aquasecurity/trivy/v${TRIVY_VERSION}/contrib/install.sh" \
      | sh -s -- -b /usr/local/bin "v${TRIVY_VERSION}"

# --- osv-scanner ---
RUN curl -fsSL -o /usr/local/bin/osv-scanner \
      "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_${TARGETARCH}" \
    && chmod +x /usr/local/bin/osv-scanner

# --- semgrep + zizmor (pip) ---
RUN pip install --no-cache-dir \
        "semgrep==${SEMGREP_VERSION}" \
        "zizmor==${ZIZMOR_VERSION}"

# --- python helpers used by the entrypoint/normalizer ---
RUN pip install --no-cache-dir PyYAML==6.0.2

COPY docker/scanner-entrypoint.sh /usr/local/bin/scanner-entrypoint.sh
RUN chmod +x /usr/local/bin/scanner-entrypoint.sh

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin scanner
USER 10001:10001

WORKDIR /scan
ENTRYPOINT ["/usr/local/bin/scanner-entrypoint.sh"]
